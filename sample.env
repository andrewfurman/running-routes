# Copy this file to .env at the repository root and fill in values locally.
# This repository is public. Commit this blank template only, never .env.

# Google Maps (browser key; restrict allowed websites and APIs in Google Cloud)
GOOGLE_MAPS_API_KEY=

# Cloudflare deployment and R2 uploads
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Private Strava browser session (the signed-in cookie, not an OAuth token)
STRAVA_WEB_COOKIE=
# Private token protecting manual sync requests
STRAVA_SYNC_ADMIN_TOKEN=
